# Server port
PORT=3000

# Secret used to sign JWT tokens. Generate a strong random value for production,
# e.g. with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-strong-random-secret-in-production

# SQLite database file location. On Render, point this at the persistent disk:
#   DB_PATH=/var/data/attendance.db
DB_PATH=./data/attendance.db

# Allowed browser origins for CORS (comma-separated list).
# Example: the GitHub Pages frontend + the app's own Render URL.
# Use * to allow all origins (development only).
CORS_ORIGIN=*
# CORS_ORIGIN=https://mjkulit03.github.io,https://offsite-employee-login.onrender.com
